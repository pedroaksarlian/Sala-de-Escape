@{
    var tiempoRestante = ViewBag.TiempoRestanteSegundos as int? ?? 1800;
}

<div id="timerContainer" class="timer-container" style="position: fixed; top: 20px; right: 20px; background: rgba(0, 0, 0, 0.8); border: 2px solid #dc3545; border-radius: 8px; padding: 10px 15px; color: white; font-size: 18px; font-weight: bold; z-index: 9999; min-width: 150px; text-align: center;">
    <div style="font-size: 12px; color: #aaa; margin-bottom: 5px;">TIEMPO RESTANTE</div>
    <div id="timerDisplay">@(tiempoRestante / 60):@((tiempoRestante % 60).ToString("D2"))</div>
    <div style="font-size: 10px; color: #aaa; margin-top: 5px;">@tiempoRestante segundos</div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    let tiempoRestante = @tiempoRestante;
    let isAutoSaving = false;
    const timerDisplay = document.getElementById('timerDisplay');
    const timerContainer = document.getElementById('timerContainer');

    // Función para guardar el tiempo al servidor
    function guardarTiempoAlServidor(segundos) {
        if (isAutoSaving) return;
        isAutoSaving = true;
        fetch('/Home/GuardarTiempo', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
            },
            body: 'tiempoSegundos=' + Math.max(0, segundos)
        }).finally(() => {
            isAutoSaving = false;
        });
    }

    // Hacer la función disponible globalmente
    window.guardarTiempoActual = function() {
        guardarTiempoAlServidor(tiempoRestante);
        return new Promise(resolve => {
            setTimeout(resolve, 100);
        });
    };

    // Interceptar forms para agregar el tiempo antes de submit
    document.addEventListener('submit', function(event) {
        const form = event.target;
        // Crear o actualizar un input oculto con el tiempo actual
        let tiempoInput = form.querySelector('input[name="tiempoRestanteSegundos"]');
        if (!tiempoInput) {
            tiempoInput = document.createElement('input');
            tiempoInput.type = 'hidden';
            tiempoInput.name = 'tiempoRestanteSegundos';
            form.appendChild(tiempoInput);
        }
        tiempoInput.value = Math.max(0, tiempoRestante);
    }, true);

    // Guardar tiempo cuando se está a punto de dejar la página
    window.addEventListener('beforeunload', function() {
        if (tiempoRestante > 0) {
            navigator.sendBeacon('/Home/GuardarTiempo', 'tiempoSegundos=' + tiempoRestante);
        }
    });

    function actualizarTimer() {
        const minutos = Math.floor(tiempoRestante / 60);
        const segundos = tiempoRestante % 60;
        timerDisplay.textContent = minutos + ':' + (segundos < 10 ? '0' : '') + segundos;

        if (tiempoRestante <= 300) {
            timerContainer.style.borderColor = '#ff6b6b';
            timerContainer.style.backgroundColor = 'rgba(139, 0, 0, 0.8)';
        }

        if (tiempoRestante <= 0) {
            timerDisplay.textContent = '0:00';
            timerContainer.style.borderColor = '#ff0000';
            timerContainer.style.backgroundColor = 'rgba(200, 0, 0, 0.9)';
            // Guardar tiempo antes de redirigir
            guardarTiempoAlServidor(0);
            // Reproducir video de derrota y avisar al servidor
            try {
                window.playGlobalVideo('/videos/Soccer_players_running_in_tunnel_20260910090754.mp4').then(function(){
                    // notificar al servidor que perdió y redirigir según respuesta
                    fetch('@Url.Action("Perder", "Home")', { method: 'POST' })
                        .then(r => r.json())
                        .then(j => { if (j && j.redirect) window.location.href = j.redirect; else window.location.href = '@Url.Action("Index", "Home")'; })
                        .catch(()=> { window.location.href = '@Url.Action("Index", "Home")'; });
                }).catch(function(){ window.location.href = '@Url.Action("Index", "Home")'; });
            } catch(e) {
                window.location.href = '@Url.Action("Index", "Home")';
            }
            return;
        }

        tiempoRestante--;
    }

    // Actualizar cada segundo (sin guardado automático)
    setInterval(actualizarTimer, 1000);
});
</script>

<style>
    .timer-container {
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        transition: all 0.3s ease;
    }

    .timer-container:hover {
        transform: scale(1.05);
    }
</style>
