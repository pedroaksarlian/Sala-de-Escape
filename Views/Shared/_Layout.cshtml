<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TP06</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TP06.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var participante = ViewBag.Participante as string ?? "Jugador";
        var habitacion = ViewBag.HabitacionActual as string ?? "Sala";
        var partidaEnCurso = ViewBag.PartidaEnCurso is bool enCurso && enCurso;
    }

    @if (partidaEnCurso)
    {
        <div class="room-status-bar">
            <div class="room-status-left">
                <span class="status-label">Participante</span>
                <strong>@participante</strong>
            </div>
            <div class="room-status-center">
                <span class="status-label">Sala actual</span>
                <strong>@habitacion</strong>
            </div>
            <div class="room-status-right">
                <span class="status-pill">Partida en curso</span>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
