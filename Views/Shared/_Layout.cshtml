<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TP06</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TP06.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var participante = ViewBag.Participante as string ?? "Jugador";
        var habitacion = ViewBag.HabitacionActual as string ?? "Sala";
        var partidaEnCurso = ViewBag.PartidaEnCurso is bool enCurso && enCurso;
    }

    @if (partidaEnCurso)
    {
        <div class="room-status-bar">
            <div class="room-status-left">
                <span class="status-label">Participante</span>
                <strong>@participante</strong>
            </div>
            <div class="room-status-center">
                <span class="status-label">Sala actual</span>
                <strong>@habitacion</strong>
            </div>
            <div class="room-status-right">
                <span class="status-pill">Partida en curso</span>
                <button id="showCodesBtn" class="btn btn-sm btn-outline-light ms-2" type="button" data-bs-toggle="modal" data-bs-target="#codesModal">Mostrar códigos</button>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (!string.IsNullOrWhiteSpace(ViewBag.IntroVideo as string))
    {
        <div id="introVideoOverlay" style="position:fixed; inset:0; z-index:2000; display:flex; align-items:center; justify-content:center; background:#000;">
            <video id="introVideoPlayer" autoplay muted playsinline preload="auto" style="width:100vw; height:100vh; object-fit:cover; background:#000; display:block;"></video>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                try {
                    var src = '@Url.Content((string)ViewBag.IntroVideo)';
                    var overlay = document.getElementById('introVideoOverlay');
                    var v = document.getElementById('introVideoPlayer');

                    if (!src || !overlay || !v) return;

                    v.src = src;
                    v.muted = true;
                    v.load();

                    var startPlayback = function () {
                        v.muted = true;
                        v.play().catch(function () {
                            setTimeout(function () {
                                try { v.muted = true; v.play().catch(function () {}); } catch (e) {}
                            }, 250);
                        });
                    };

                    v.addEventListener('loadeddata', function () {
                        setTimeout(startPlayback, 100);
                    });

                    v.addEventListener('ended', function () {
                        try { overlay.remove(); } catch (e) {}
                    });

                    v.addEventListener('error', function () {
                        try { overlay.remove(); } catch (e) {}
                    });

                    setTimeout(startPlayback, 200);
                } catch (e) {
                    console && console.warn && console.warn(e);
                }
            });
        </script>
    }

    <!-- Global video modal and helper -->
    <div class="modal fade" id="globalVideoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-header border-0">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-0" style="position:relative;">
                    <video id="globalVideoPlayer" class="w-100 h-100" style="object-fit:cover; width:100vw; height:100vh;" playsinline preload="auto" controls></video>
                    <button id="globalVideoUnmute" type="button" class="btn btn-light" style="position:absolute;left:1rem;bottom:1rem;z-index:1055;display:none;">Activar sonido</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.playGlobalVideo = function(src, opts) {
            opts = opts || {};
            return new Promise(function(resolve, reject){
                try {
                    var modalEl = document.getElementById('globalVideoModal');
                    var player = document.getElementById('globalVideoPlayer');
                    var unmuteBtn = document.getElementById('globalVideoUnmute');
                    var modal = new bootstrap.Modal(modalEl, { backdrop: 'static', keyboard: false });

                    // cleanup previous
                    player.pause(); player.removeAttribute('src'); player.load();

                    // set source
                    player.src = src;
                    player.muted = true; // start muted to allow autoplay

                    function endedHandler(){
                        modal.hide();
                        cleanup();
                        resolve();
                    }

                    function cleanup(){
                        player.removeEventListener('ended', endedHandler);
                        modalEl.removeEventListener('hidden.bs.modal', hiddenHandler);
                        if (unmuteBtn) unmuteBtn.style.display = 'none';
                    }

                    function hiddenHandler(){
                        try { player.pause(); player.currentTime = 0; } catch(e){}
                        cleanup();
                        resolve();
                    }

                    player.addEventListener('ended', endedHandler);
                    modalEl.addEventListener('hidden.bs.modal', hiddenHandler);

                    if (unmuteBtn) {
                        unmuteBtn.style.display = 'inline-block';
                        unmuteBtn.onclick = function(){ player.muted = false; player.play().catch(function(){}); unmuteBtn.style.display='none'; };
                    }

                    // show and try to play
                    setTimeout(function(){ modal.show(); }, 50);
                    var p = player.play();
                    if (p && p.catch) {
                        p.catch(function(){ try { player.muted = true; player.play().catch(function(){}); } catch(e){} });
                    }

                } catch (e) { console && console.warn && console.warn(e); reject(e); }
            };
        };
    </script>

    <!-- Codes modal -->
    <div class="modal fade" id="codesModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Códigos de la partida</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>Estos códigos te permiten volver a la sala y retomar la partida donde la dejaste.</p>
                    <dl>
                        <dt>Código de sala</dt>
                        <dd><strong>@(ViewBag.CodigoSala as string ?? "(no disponible)")</strong></dd>
                        <dt>Código de sesión</dt>
                        <dd><strong>@(ViewBag.CodigoSesion as string ?? (Context.Session.GetString("codigoActual") ?? "(no disponible)"))</strong></dd>
                    </dl>
                    <p class="small text-muted">Anotá ambos códigos y guardalos en un lugar seguro.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    @*
        Visor de historia de la sala.
        Cada vista de sala define, dentro de su bloque @@{ }:
            ViewBag.HistoriaImagenes = new[] { "/img/Foto.jpg", ... };
            ViewBag.HistoriaEfecto   = "fade" | "slide" | "zoom" | "flip";
            ViewBag.HistoriaTitulo   = "Texto del badge";
        No toca la lógica de la sala: se muestra encima y se puede cerrar.
    *@
    @{
        var historiaImagenes = ViewBag.HistoriaImagenes as IEnumerable<string>;
        var historiaLista = historiaImagenes?.Where(x => !string.IsNullOrWhiteSpace(x)).ToList() ?? new List<string>();
        var historiaEfecto = ViewBag.HistoriaEfecto as string ?? "fade";
        var historiaTitulo = ViewBag.HistoriaTitulo as string ?? "La historia de la sala";
    }

    @if (historiaLista.Count > 0)
    {
        <div id="historiaOverlay" class="historia-overlay" role="dialog" aria-modal="true" aria-label="@historiaTitulo" hidden>
            <div class="historia-dialog">
                <div class="historia-head">
                    <span class="badge">@historiaTitulo</span>
                    <button type="button" class="historia-close" id="historiaClose" aria-label="Cerrar">&times;</button>
                </div>

                <div class="historia-stage fx-@historiaEfecto" id="historiaStage">
                    <img id="historiaImg" src="@Url.Content(historiaLista[0])" alt="@historiaTitulo" />
                    <p class="historia-fallback" id="historiaFallback" hidden>No se pudo cargar esta foto.</p>
                    @if (historiaLista.Count > 1)
                    {
                        <button type="button" class="historia-nav prev" id="historiaPrev" aria-label="Foto anterior">&#10094;</button>
                        <button type="button" class="historia-nav next" id="historiaNext" aria-label="Foto siguiente">&#10095;</button>
                    }
                </div>

                <div class="historia-foot">
                    @if (historiaLista.Count > 1)
                    {
                        <div class="historia-dots" id="historiaDots"></div>
                        <span class="historia-hint">Usá las flechas ← → para pasar de foto · Esc para cerrar</span>
                    }
                    else
                    {
                        <span></span>
                        <span class="historia-hint">Esc o la X para cerrar</span>
                    }
                </div>
            </div>
        </div>

        <script>
            (function () {
                var fotos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(historiaLista.Select(f => Url.Content(f))));
                var claveSala = 'historiaVista:' + window.location.pathname.toLowerCase();
                var overlay = document.getElementById('historiaOverlay');
                var stage = document.getElementById('historiaStage');
                var img = document.getElementById('historiaImg');
                var dotsBox = document.getElementById('historiaDots');
                var prevBtn = document.getElementById('historiaPrev');
                var nextBtn = document.getElementById('historiaNext');
                var closeBtn = document.getElementById('historiaClose');
                var fallback = document.getElementById('historiaFallback');
                var i = 0;
                var animando = false;

                // Si un archivo está roto o falta, mostramos un aviso en vez del ícono
                // de imagen rota del navegador.
                img.addEventListener('error', function () {
                    img.hidden = true;
                    if (fallback) { fallback.hidden = false; }
                });
                img.addEventListener('load', function () {
                    img.hidden = false;
                    if (fallback) { fallback.hidden = true; }
                });

                function yaVista() {
                    try { return sessionStorage.getItem(claveSala) === '1'; } catch (e) { return false; }
                }

                function marcarVista() {
                    try { sessionStorage.setItem(claveSala, '1'); } catch (e) { /* modo privado */ }
                }

                // Precargamos para que la transición no muestre un hueco en blanco.
                fotos.forEach(function (src) { var p = new Image(); p.src = src; });

                if (dotsBox) {
                    fotos.forEach(function (_, idx) {
                        var d = document.createElement('button');
                        d.type = 'button';
                        d.className = 'historia-dot' + (idx === 0 ? ' active' : '');
                        d.setAttribute('aria-label', 'Foto ' + (idx + 1));
                        d.addEventListener('click', function () { mostrar(idx); });
                        dotsBox.appendChild(d);
                    });
                }

                function pintarEstado() {
                    if (dotsBox) {
                        Array.prototype.forEach.call(dotsBox.children, function (d, idx) {
                            d.classList.toggle('active', idx === i);
                        });
                    }
                    if (prevBtn) { prevBtn.disabled = (i === 0); }
                    if (nextBtn) { nextBtn.disabled = (i === fotos.length - 1); }
                }

                function mostrar(destino) {
                    if (animando || destino === i || destino < 0 || destino >= fotos.length) return;
                    var haciaAtras = destino < i;
                    animando = true;

                    img.classList.remove('is-entering', 'back');
                    img.classList.add('is-leaving');
                    if (haciaAtras) { img.classList.add('back'); }

                    setTimeout(function () {
                        i = destino;
                        img.src = fotos[i];
                        img.classList.remove('is-leaving', 'back');
                        img.classList.add('is-entering');
                        if (haciaAtras) { img.classList.add('back'); }
                        pintarEstado();
                        setTimeout(function () {
                            img.classList.remove('is-entering', 'back');
                            animando = false;
                        }, 700);
                    }, 380);
                }

                function abrir() {
                    marcarVista();
                    overlay.hidden = false;
                    // un tick para que la transición de opacidad se dispare
                    requestAnimationFrame(function () { overlay.classList.add('is-open'); });
                    img.classList.add('is-entering');
                    setTimeout(function () { img.classList.remove('is-entering'); }, 700);
                    document.body.style.overflow = 'hidden';
                    pintarEstado();
                }

                function cerrar() {
                    overlay.classList.remove('is-open');
                    document.body.style.overflow = '';
                    setTimeout(function () { overlay.hidden = true; }, 350);
                }

                window.abrirHistoriaSala = abrir;

                if (closeBtn) { closeBtn.addEventListener('click', cerrar); }
                if (prevBtn) { prevBtn.addEventListener('click', function () { mostrar(i - 1); }); }
                if (nextBtn) { nextBtn.addEventListener('click', function () { mostrar(i + 1); }); }

                overlay.addEventListener('click', function (e) {
                    if (e.target === overlay) { cerrar(); }
                });

                document.addEventListener('keydown', function (e) {
                    if (overlay.hidden) return;
                    if (e.key === 'Escape') { cerrar(); }
                    else if (e.key === 'ArrowRight') { mostrar(i + 1); }
                    else if (e.key === 'ArrowLeft') { mostrar(i - 1); }
                });

                // Botón "Ver la historia" dentro de la sala, si existe.
                var reopen = document.getElementById('historiaReopen');
                if (reopen) { reopen.addEventListener('click', abrir); }

                // Se abre solo la primera vez que entrás a la sala, esperando a que
                // termine el video de intro. Después de cada decisión (que recarga la
                // página) ya queda marcada como vista y no vuelve a aparecer sola.
                function abrirCuandoSePueda() {
                    var intro = document.getElementById('introVideoOverlay');
                    if (intro && document.body.contains(intro)) {
                        setTimeout(abrirCuandoSePueda, 400);
                        return;
                    }
                    abrir();
                }

                document.addEventListener('DOMContentLoaded', function () {
                    if (yaVista()) { return; }
                    setTimeout(abrirCuandoSePueda, 350);
                });
            })();
        </script>
    }
</body>
</html>
