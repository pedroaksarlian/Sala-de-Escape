<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TP06</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TP06.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var participante = ViewBag.Participante as string ?? "Jugador";
        var habitacion = ViewBag.HabitacionActual as string ?? "Sala";
        var partidaEnCurso = ViewBag.PartidaEnCurso is bool enCurso && enCurso;
    }

    @if (partidaEnCurso)
    {
        <div class="room-status-bar">
            <div class="room-status-left">
                <span class="status-label">Participante</span>
                <strong>@participante</strong>
            </div>
            <div class="room-status-center">
                <span class="status-label">Sala actual</span>
                <strong>@habitacion</strong>
            </div>
            <div class="room-status-right">
                <span class="status-pill">Partida en curso</span>
            </div>
        </div>
    }

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @if (ViewBag.IntroVideo != null)
    {
        <div class="modal fade" id="introVideoModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-fullscreen">
                <div class="modal-content bg-transparent border-0">
                    <div class="modal-header border-0">
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body p-0" style="position:relative;">
                        <video id="introVideoPlayer" class="w-100 h-100" style="object-fit:cover; width:100vw; height:100vh;" playsinline autoplay muted preload="auto" controls>
                            <source src="@ViewBag.IntroVideo" type="video/mp4" />
                            Tu navegador no soporta video.
                        </video>
                        <button id="introVideoUnmute" type="button" class="btn btn-light" style="position:absolute;left:1rem;bottom:1rem;z-index:1055;display:none;">Activar sonido</button>
                    </div>
                </div>
            </div>
        </div>

        <script>
            $(function(){
                try {
                    var modalEl = document.getElementById('introVideoModal');
                    var modal = new bootstrap.Modal(modalEl, { backdrop: 'static', keyboard: false });
                    var v = document.getElementById('introVideoPlayer');
                    var unmuteBtn = document.getElementById('introVideoUnmute');

                    function showAndPlay() {
                        // small delay to ensure CSS and focus state ready
                        setTimeout(function(){ modal.show(); }, 50);
                        v.currentTime = 0;
                        // ensure muted initially so autoplay is allowed
                        try { v.muted = true; } catch(e) {}
                        var p = v.play();
                        if (p !== undefined) {
                            p.then(function(){
                                // playing succeeded (muted). Offer unmute button
                                try { unmuteBtn.style.display = 'inline-block'; } catch(e) {}
                            }).catch(function(){
                                // play failed even muted - try forced muted play
                                try { v.muted = true; v.play().catch(function(){}); unmuteBtn.style.display = 'inline-block'; } catch(e) {}
                            });
                        } else {
                            // no promise, show unmute control
                            try { unmuteBtn.style.display = 'inline-block'; } catch(e) {}
                        }
                    }

                    // close when video ends
                    v.addEventListener('ended', function(){ try { modal.hide(); } catch(e) {} });

                    // when modal hides pause and reset
                    modalEl.addEventListener('hidden.bs.modal', function(){ try { v.pause(); v.currentTime = 0; v.muted = false; unmuteBtn.style.display = 'none'; } catch(e) {} });

                    // unmute button
                    if (unmuteBtn) {
                        unmuteBtn.addEventListener('click', function(){
                            try {
                                v.muted = false;
                                v.play().catch(function(){});
                                unmuteBtn.style.display = 'none';
                            } catch(e) {}
                        });
                    }

                    showAndPlay();
                } catch (e) { console && console.warn && console.warn(e); }
            });
        </script>
    }

    <!-- Global video modal and helper -->
    <div class="modal fade" id="globalVideoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content bg-transparent border-0">
                <div class="modal-header border-0">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-0" style="position:relative;">
                    <video id="globalVideoPlayer" class="w-100 h-100" style="object-fit:cover; width:100vw; height:100vh;" playsinline preload="auto" controls></video>
                    <button id="globalVideoUnmute" type="button" class="btn btn-light" style="position:absolute;left:1rem;bottom:1rem;z-index:1055;display:none;">Activar sonido</button>
                </div>
            </div>
        </div>
    </div>

    <script>
        window.playGlobalVideo = function(src, opts) {
            opts = opts || {};
            return new Promise(function(resolve, reject){
                try {
                    var modalEl = document.getElementById('globalVideoModal');
                    var player = document.getElementById('globalVideoPlayer');
                    var unmuteBtn = document.getElementById('globalVideoUnmute');
                    var modal = new bootstrap.Modal(modalEl, { backdrop: 'static', keyboard: false });

                    // cleanup previous
                    player.pause(); player.removeAttribute('src'); player.load();

                    // set source
                    player.src = src;
                    player.muted = true; // start muted to allow autoplay

                    function endedHandler(){
                        modal.hide();
                        cleanup();
                        resolve();
                    }

                    function cleanup(){
                        player.removeEventListener('ended', endedHandler);
                        modalEl.removeEventListener('hidden.bs.modal', hiddenHandler);
                        if (unmuteBtn) unmuteBtn.style.display = 'none';
                    }

                    function hiddenHandler(){
                        try { player.pause(); player.currentTime = 0; } catch(e){}
                        cleanup();
                        resolve();
                    }

                    player.addEventListener('ended', endedHandler);
                    modalEl.addEventListener('hidden.bs.modal', hiddenHandler);

                    if (unmuteBtn) {
                        unmuteBtn.style.display = 'inline-block';
                        unmuteBtn.onclick = function(){ player.muted = false; player.play().catch(function(){}); unmuteBtn.style.display='none'; };
                    }

                    // show and try to play
                    setTimeout(function(){ modal.show(); }, 50);
                    var p = player.play();
                    if (p && p.catch) {
                        p.catch(function(){ try { player.muted = true; player.play().catch(function(){}); } catch(e){} });
                    }

                } catch (e) { console && console.warn && console.warn(e); reject(e); }
            });
        };
    </script>
</body>
</html>
