@{
    ViewData["Title"] = "Acuña";
    ViewBag.HistoriaTitulo = "Acuña pide ayuda";
    ViewBag.HistoriaEfecto = "zoom";
    ViewBag.HistoriaImagenes = new[] { "/img/Acu%C3%B1a%20ayuda.jfif" };
    var mensaje = ViewBag.Mensaje as string;
    var correcto = ViewBag.Correcto is bool value && value;
}

@Html.Partial("_Timer", (object)ViewBag.TiempoRestanteSegundos)

<div class="challenge-page">
    <a asp-controller="Home" asp-action="Index" class="back-link">← Volver al inicio</a>
    <button type="button" id="historiaReopen" class="historia-reopen">⚑ Ver la historia de la sala</button>
    <div class="challenge-panel">
        <span class="badge">Desafío 2 · Acuña</span>
        <h1>LAS COSAS DEL HUEVO</h1>
        <p>
            El Huevo te quiere ayudar a escapar, pero para eso tenés que encontrar los objetos que te va a pedir. Ayudalo a buscarlos.
        </p>

        <div class="find-instructions" style="margin-bottom:0.6rem;font-weight:700;color:#fde68a;">
            Buscá y tocá en la imagen: <span style="color:#fff;">Gorra</span>, <span style="color:#fff;">Remera</span>, <span style="color:#fff;">Mochila</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(correcto ? "alert-success" : "alert-danger")">@mensaje</div>
        }

        <form asp-controller="Home" asp-action="Acuna" method="post" class="challenge-form">
            <div class="room-wrapper">
                <img src="/img/AcuñaVestuario.png" id="acuna-image" alt="Vestuario Acuña" />
                <!-- Posiciones base ajustadas para el layout real de la imagen. Si hay posiciones viejas guardadas en localStorage, se reemplazan al cargar la página. -->
                <div class="hotspot" data-item="gorra" data-radius-percent="4" style="left:31%; top:12%;" title="Gorra"></div>
                <div class="hotspot" data-item="remera" data-radius-percent="4" style="left:55%; top:15%;" title="Remera"></div>
                <div class="hotspot" data-item="mochila" data-radius-percent="6" style="left:69%; top:76%;" title="Mochila"></div>
            </div>

            <div id="find-live" aria-live="polite" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">
                
            </div>

            <!-- check-list removed: discovery is via clicking the image hotspots -->
        </form>

        <script src="/js/findObjects.js"></script>
    </div>
</div>
