@{
    ViewData["Title"] = "Di Carlo";
    ViewBag.HistoriaTitulo = "Di Carlo: Pezzella no pasa";
    ViewBag.HistoriaEfecto = "slide";
    ViewBag.HistoriaImagenes = new[]
    {
        "/img/Di%20Carlo.jfif",
        "/img/Pezzela%20No%20Pasa.jfif",
        "/img/Pezzela%20no%20Pasa%202.0.jfif"
    };
    var mensaje = ViewBag.Mensaje as string;
    var correcto = ViewBag.Correcto is bool value && value;
    var equipo = ViewBag.EquipoDonofrio as List<TP06.Models.JugadorDiCarlo> ?? new List<TP06.Models.JugadorDiCarlo>();
    var escena = ViewBag.Escena as TP06.Controllers.HomeController.DiCarloEscena;
    var titulo = escena?.Titulo ?? "La última jugada";
    var texto = escena?.Texto ?? "El partido está en una situación decisiva. Elegí bien para seguir vivo en la sala.";
    var opciones = escena?.Opciones ?? Array.Empty<string>();
    var partidoGanado = ViewBag.PartidoGanado is bool value2 && value2;
    var partidoPerdido = ViewBag.PartidoPerdido is bool value3 && value3;
    var golesArgentina = ViewBag.GolesArgentina is int gaval ? gaval : 0;
    var golesRival = ViewBag.GolesRival is int grval ? grval : 0;
    var enPenales = ViewBag.EnPenales is bool epval && epval;
    var minutoActual = ViewBag.MinutoActual as string;
    var ultimoMinuto = ViewBag.UltimoMinuto as string;
    var ultimoResultadoTipo = ViewBag.UltimoResultadoTipo as string;
    var ultimoResultadoTexto = ViewBag.UltimoResultadoTexto as string;
    var ultimoResultadoCorrecto = ViewBag.UltimoResultadoCorrecto as bool?;

    string ResultadoIcono(string? tipo) => tipo switch
    {
        "GOL" => "⚽",
        "GOL_RIVAL" => "🤖",
        "ATAJADA" => "🧤",
        "PALO" => "🥅",
        "DEFENSOR" => "🛡️",
        "AFUERA" => "💨",
        _ => "▶️"
    };

    string ResultadoLabel(string? tipo) => tipo switch
    {
        "GOL" => "¡GOL DE CANTILO!",
        "GOL_RIVAL" => "GOL DE LOS ROBOTS",
        "ATAJADA" => "LA ATAJÓ EL ARQUERO",
        "PALO" => "PEGÓ EN EL PALO",
        "DEFENSOR" => "LA SACÓ EL DEFENSOR",
        "AFUERA" => "LA MANDASTE AFUERA",
        _ => "SITUACIÓN"
    };
}

@Html.Partial("_Timer", (object)ViewBag.TiempoRestanteSegundos)

<div class="challenge-page">
    <a asp-controller="Home" asp-action="Index" class="back-link">← Volver al inicio</a>
    <button type="button" id="historiaReopen" class="historia-reopen">⚑ Ver la historia de la sala</button>

    <div class="challenge-panel dicarlo-panel">
        <span class="badge">Desafío 7 · Di Carlo</span>
        <h1>LA FINAL</h1>
        <p>
        Llegaste hasta acá con la suerte del Chacho, el aleman de Micho, el equipo de Donofrio y otras habilidades que fuiste aprendiendo. Ahora solo queda una sola cosa: JUGAR LA FINAL.
        </p>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(correcto ? "alert-success decision-correct" : "alert-danger decision-wrong")">
                <div class="decision-feedback">
                    <span class="decision-icon">@(correcto ? "✓" : "✗")</span>
                    <div class="decision-text">
                        <strong>@(correcto ? "¡ACIERTO!" : "¡ERROR!")</strong>
                        <p>@mensaje</p>
                    </div>
                </div>
            </div>
        }

        <div class="dicarlo-match-shell">
            <div class="dicarlo-field">
                <div class="dicarlo-match-header">
                    <div class="match-badge-group">
                        <span class="match-badge">Marcador</span>
                        <span class="match-minute">@(enPenales ? "PENALES" : minutoActual)</span>
                    </div>
                    <div class="match-score">
                        <span class="team-argentina">🇦🇷 Cantilo <strong>@golesArgentina</strong></span>
                        <span class="score-separator">-</span>
                        <span class="team-rival"><strong>@golesRival</strong> Los Robots 🤖</span>
                    </div>
                </div>

                @if (enPenales)
                {
                    <div class="penales-indicator">
                        <strong>¡PENALES!</strong>
                        <p>Un tiro desde los 12 pasos puede salvarte o condenarte.</p>
                    </div>
                }

                <div class="dicarlo-match-body">
                    @if (string.IsNullOrWhiteSpace(ultimoResultadoTipo))
                    {
                        <div class="resultado-anterior resultado-neutro">
                            <span class="resultado-icono">🏟️</span>
                            <div class="resultado-texto">
                                <strong>ARRANCA EL PARTIDO</strong>
                                <p>Prestá atención a la situación y confirmá tu decisión.</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="resultado-anterior @(ultimoResultadoCorrecto == true ? "resultado-positivo" : "resultado-negativo")">
                            <span class="resultado-icono">@ResultadoIcono(ultimoResultadoTipo)</span>
                            <div class="resultado-texto">
                                <strong>@ultimoMinuto &middot; @ResultadoLabel(ultimoResultadoTipo)</strong>
                                <p>@ultimoResultadoTexto</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="dicarlo-clue-box">
                <div class="clue-header">Situación actual</div>
                <div class="clue-text">
                    @texto
                </div>
            </div>

            <div class="dicarlo-bottom-row">
                <div class="plantilla-panel">
                    <h3>Equipo</h3>
                    <div class="plantilla-list">
                        @if (equipo.Count == 0)
                        {
                            <span class="plantilla-empty">Todavía no armaste el once.</span>
                        }
                        else
                        {
                            @foreach (var jugador in equipo)
                            {
                                <div class="plantilla-player">
                                    <span>@jugador.Nombre</span>
                                    <small>@jugador.Posicion</small>
                                </div>
                            }
                        }
                    </div>
                </div>

                @if (!partidoGanado && !partidoPerdido)
                {
                    @if (!enPenales)
                    {
                        <form asp-controller="Home" asp-action="DiCarlo" method="post" class="challenge-form dicarlo-form">
                            <label>Decisión</label>
                            <div class="dicarlo-choice-grid" id="dicarloChoices">
                                @foreach (var opcion in opciones)
                                {
                                    <button type="button" class="btn dicarlo-choice-btn" data-value="@opcion">
                                        @opcion
                                    </button>
                                }
                            </div>
                            <input type="hidden" name="decision" id="dicarloDecisionInput" value="" />
                            <button type="submit" class="btn btn-confirm-decision" id="dicarloConfirmBtn" disabled>
                                Confirmar decisión
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Home" asp-action="Penales" method="post" class="challenge-form dicarlo-form">
                            <label>¿Hacia dónde pateás?</label>
                            <div class="dicarlo-choice-grid" id="penalesChoices">
                                <button type="button" class="btn dicarlo-choice-btn" data-value="arriba-izquierda">
                                    Arriba Izquierda ↖️
                                </button>
                                <button type="button" class="btn dicarlo-choice-btn" data-value="arriba-derecha">
                                    Arriba Derecha ↗️
                                </button>
                                <button type="button" class="btn dicarlo-choice-btn" data-value="centro">
                                    Centro 🎯
                                </button>
                                <button type="button" class="btn dicarlo-choice-btn" data-value="abajo-izquierda">
                                    Abajo Izquierda ↙️
                                </button>
                                <button type="button" class="btn dicarlo-choice-btn" data-value="abajo-derecha">
                                    Abajo Derecha ↘️
                                </button>
                            </div>
                            <input type="hidden" name="decision" id="penalesDecisionInput" value="" />
                            <button type="submit" class="btn btn-confirm-decision" id="penalesConfirmBtn" disabled>
                                Confirmar remate
                            </button>
                        </form>
                    }
                }
            </div>

            @if (partidoGanado)
            {
                <div class="dicarlo-continue">
                    <a asp-controller="Home" asp-action="Ganaste" class="btn btn-success btn-lg">Escapar de la sala</a>
                </div>
            }
        </div>
    </div>
</div>

<script>
(function () {
    function setupConfirmChoice(containerId, inputId, buttonId) {
        var container = document.getElementById(containerId);
        var input = document.getElementById(inputId);
        var confirmBtn = document.getElementById(buttonId);
        if (!container || !input || !confirmBtn) {
            return;
        }

        container.querySelectorAll('.dicarlo-choice-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
                container.querySelectorAll('.dicarlo-choice-btn').forEach(function (b) {
                    b.classList.remove('selected');
                });
                btn.classList.add('selected');
                input.value = btn.dataset.value;
                confirmBtn.disabled = false;
            });
        });
    }

    setupConfirmChoice('dicarloChoices', 'dicarloDecisionInput', 'dicarloConfirmBtn');
    setupConfirmChoice('penalesChoices', 'penalesDecisionInput', 'penalesConfirmBtn');
})();
</script>
