@{
    ViewData["Title"] = "Di Carlo";
    var mensaje = ViewBag.Mensaje as string;
    var correcto = ViewBag.Correcto is bool value && value;
    var jugadores = ViewBag.Jugadores as List<TP06.Models.JugadorDiCarlo> ?? new List<TP06.Models.JugadorDiCarlo>();
    var plantilla = ViewBag.Plantilla as List<TP06.Models.JugadorDiCarlo> ?? new List<TP06.Models.JugadorDiCarlo>();
    var objetivo = ViewBag.Objetivo as TP06.Models.JugadorDiCarlo;
    var tablero = ViewBag.Tablero as List<dynamic> ?? new List<dynamic>();
    var equipoCompleto = ViewBag.EquipoCompleto is bool value2 && value2;
}

@Html.Partial("_Timer", (object)ViewBag.TiempoRestanteSegundos)

<div class="challenge-page">
    <a asp-controller="Home" asp-action="Index" class="back-link">← Volver al inicio</a>
    <div class="challenge-panel dicarlo-panel">
        <span class="badge">Desafío 7 · Di Carlo</span>
        <h1>Plantilla imposible</h1>
        <p>
            Adiviná al jugador correcto a partir de la pista y completá la formación del equipo.
        </p>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(correcto ? "alert-success" : "alert-danger")">@mensaje</div>
        }

        <div class="dicarlo-shell">
            <div class="dicarlo-field">
                @foreach (var slot in tablero)
                {
                    var jugador = slot.Jugador as TP06.Models.JugadorDiCarlo;
                    <div class="field-slot @(jugador != null ? "filled" : "empty")">
                        @if (jugador != null)
                        {
                            <span class="slot-name">@jugador.Nombre</span>
                            <span class="slot-mini">@jugador.Posicion</span>
                        }
                        else
                        {
                            <span class="slot-label">@slot.Label</span>
                        }
                    </div>
                }
            </div>

            <div class="dicarlo-clue-box">
                @if (objetivo != null)
                {
                    <div class="clue-header">Pista del jugador a adivinar</div>
                    <div class="clue-text">@objetivo.Adivinanza</div>
                }
                else
                {
                    <div class="clue-header">¡Equipo completo!</div>
                    <div class="clue-text">Ya descubriste a todos los jugadores.</div>
                }
            </div>

            <div class="dicarlo-bottom-row">
                <div class="plantilla-panel">
                    <h3>Plantilla</h3>
                    <div class="plantilla-list">
                        @if (plantilla.Count == 0)
                        {
                            <span class="plantilla-empty">Todavía no agregaste jugadores.</span>
                        }
                        else
                        {
                            @foreach (var jugador in plantilla)
                            {
                                <div class="plantilla-player">
                                    <span>@jugador.Nombre</span>
                                    <small>@jugador.Posicion</small>
                                </div>
                            }
                        }
                    </div>
                </div>

                <form asp-controller="Home" asp-action="DiCarlo" method="post" class="challenge-form dicarlo-form">
                    <label for="respuesta">Jugador</label>
                    <div class="dicarlo-input-row">
                        <input id="respuesta" name="respuesta" type="text" class="form-control" placeholder="Escribí el nombre completo" />
                        <button type="submit" class="btn btn-danger">✓</button>
                        <button type="button" id="rendirseBtn" class="btn btn-secondary" title="Rendirse">✖ Rendirse</button>
                    </div>
                </form>
            </div>

            @if (equipoCompleto)
            {
                <div class="dicarlo-continue">
                    <a asp-controller="Home" asp-action="Ganaste" class="btn btn-success btn-lg">Continuar con el escape</a>
                </div>
            }
        </div>
    </div>
</div>

        @section Scripts {
            <script>
                document.addEventListener('DOMContentLoaded', function(){
                    var btn = document.getElementById('rendirseBtn');
                    if (!btn) return;
                    btn.addEventListener('click', function(){
                        try {
                            window.playGlobalVideo('/videos/gameover.mp4').then(function(){
                                fetch('@Url.Action("Perder", "Home")', { method: 'POST' })
                                    .then(r => r.json())
                                    .then(j => { if (j && j.redirect) window.location.href = j.redirect; else window.location.href = '@Url.Action("Index", "Home")'; })
                                    .catch(()=> { window.location.href = '@Url.Action("Index", "Home")'; });
                            }).catch(function(){ window.location.href = '@Url.Action("Index", "Home")'; });
                        } catch(e) { window.location.href = '@Url.Action("Index", "Home")'; }
                    });
                });
            </script>
        }
