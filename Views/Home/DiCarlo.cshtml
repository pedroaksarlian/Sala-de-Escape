@{
    ViewData["Title"] = "Di Carlo";
    var mensaje = ViewBag.Mensaje as string;
    var correcto = ViewBag.Correcto is bool value && value;
}

<div class="challenge-page">
    <a asp-controller="Home" asp-action="Index" class="back-link">← Volver al inicio</a>
    <div class="challenge-panel">
        <span class="badge">Desafío 7 · Di Carlo</span>
        <h1>7a0 contra leyendas</h1>
        <p>
            Un solo partido contra leyendas de River. El partido se complica con situaciones inesperadas y podés perderlo. Elegí la decisión que más ayuda a sostener el 7a0.
        </p>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(correcto ? "alert-success" : "alert-danger")">@mensaje</div>
        }

        <div class="scenario-box">
            <p>Situación: el equipo está bajo presión y el rival llegó al área. La pelota no sale limpia y una presión feroz está por matar el partido.</p>
        </div>

        <form asp-controller="Home" asp-action="DiCarlo" method="post" class="challenge-form">
            <label for="respuesta">Tu decisión</label>
            <input id="respuesta" name="respuesta" type="text" class="form-control" placeholder="Ej: PRESIONAR" />
            <button type="submit" class="btn btn-danger">Resolver</button>
        </form>
    </div>
</div>
