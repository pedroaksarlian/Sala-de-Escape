@{
    ViewData["Title"] = "Escape Room - Pezzela";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg rounded-4 bg-dark text-light">
                <div class="card-body p-5 text-center">
                    <span class="badge bg-danger rounded-pill px-3 py-2 mb-3">Escapá de Cantilo</span>
                    <h1 class="display-4 fw-bold mb-3">Pezzela intenta escapar</h1>
                    <p class="lead text-light-emphasis mb-4">
                        Meter texto de pezzela
                    </p>

                    <div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-3 mt-4">
                        <a asp-controller="Home" asp-action="PrimeraSala" class="btn btn-danger btn-lg px-4 py-3 rounded-pill fw-semibold">
                            Iniciar el escape
                        </a>

                        <form asp-controller="Home" asp-action="Continuar" method="post" class="d-flex flex-column flex-sm-row gap-2 justify-content-center align-items-center">
                            <input type="text"
                                   name="codigo"
                                   class="form-control form-control-lg rounded-pill"
                                   placeholder="Ingresá tu código"
                                   aria-label="Código de progreso" />
                            <button type="submit" class="btn btn-outline-light btn-lg px-4 py-3 rounded-pill fw-semibold">
                                Continuar el escape
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
