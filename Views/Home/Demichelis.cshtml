@{
    ViewData["Title"] = "Demichelis";
    ViewBag.HistoriaTitulo = "Demichelis y Pezzella";
    ViewBag.HistoriaEfecto = "zoom";
    ViewBag.HistoriaImagenes = new[] { "/img/Demichelis.jfif" };
    var mensaje = ViewBag.Mensaje as string;
    var correcto = ViewBag.Correcto is bool value && value;
}

@Html.Partial("_Timer", (object)ViewBag.TiempoRestanteSegundos)

<div class="challenge-page">
    <a asp-controller="Home" asp-action="Index" class="back-link">← Volver al inicio</a>
    <button type="button" id="historiaReopen" class="historia-reopen">⚑ Ver la historia de la sala</button>
    <div class="challenge-panel">
        <span class="badge">Desafío 3 · Demichelis</span>
        <h1>EL JETLAG DEL MICHO</h1>
        <p>
            Demichelis te está ayudando pero por precaución no quiere hablarte en español, prefirió su segundo idioma, el alemán. Para poder descubrir las tres palabras claves que Micho te está dando necesitas escuchar el audio, usar la pista y el diccionario.
        </p>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(correcto ? "alert-success" : "alert-danger")">@mensaje</div>
        }
        
        <div class="audio-box mb-3">
            <audio controls preload="none" class="w-100">
                <source src="@Url.Content("~/audio/Falls du entkommen willst.mp3")" type="audio/mpeg" />
                Tu navegador no soporta el elemento de audio.
            </audio>
        </div>

        <div class="mb-3 d-flex gap-2">
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#dicModal">Ver diccionario</button>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#pistaModal">Ver pista</button>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#textoModal">Ver texto</button>
        </div>

        <form asp-controller="Home" asp-action="Demichelis" method="post" class="challenge-form">
            <label>Frase decodificada</label>
            <div class="challenge-answer-grid">
                <input name="palabra1" type="text" class="form-control" placeholder="Palabra 1" maxlength="30" />
                <input name="palabra2" type="text" class="form-control" placeholder="Palabra 2" maxlength="30" />
                <input name="palabra3" type="text" class="form-control" placeholder="Palabra 3" maxlength="30" />
            </div>
            <button type="submit" class="btn btn-danger mt-2">Resolver</button>
        </form>

        <!-- Diccionario Modal -->
        <div class="modal fade" id="dicModal" tabindex="-1" aria-labelledby="dicModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="dicModalLabel">Diccionario</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <img src="@Url.Content("~/img/Diccionario.png")" alt="Diccionario" class="img-fluid" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Pista Modal -->
        <div class="modal fade" id="pistaModal" tabindex="-1" aria-labelledby="pistaModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="pistaModalLabel">Pista</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <img src="@Url.Content("~/img/Remeras Demichelis.jfif")" alt="Pista" class="img-fluid" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Texto Modal -->
        <div class="modal fade" id="textoModal" tabindex="-1" aria-labelledby="textoModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="textoModalLabel">Mensaje de Micho</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <pre>Pezzella, wenn du das hier hörst, bedeutet das, dass du es endlich bis zu mir geschafft hast. Aber ich habe nicht viel Zeit, dir zu helfen. Es gibt einen Weg, aus dem Trainingsgelände zu entkommen, aber du musst ihn selbst herausfinden.
Hör gut zu: Du musst die Tür finden, dann den Schlüssel suchen und schließlich den Ausgang finden.
Denk an diese drei Wörter. Wenn du es schaffst, sie richtig zu übersetzen, bist du der Flucht einen Schritt näher.
Viel Glück, Germán
</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
