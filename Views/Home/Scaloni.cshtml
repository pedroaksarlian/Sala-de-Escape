@{
    ViewData["Title"] = "Scaloni";
    ViewBag.HistoriaTitulo = "Scaloni y Nico González";
    ViewBag.HistoriaEfecto = "flip";
    ViewBag.HistoriaImagenes = new[] { "/img/Scaloni.jfif" };
    var mensaje = ViewBag.Mensaje as string;
    var correcto = ViewBag.Correcto is bool value && value;
}

@Html.Partial("_Timer", (object)ViewBag.TiempoRestanteSegundos)

<div class="challenge-page">
    <a asp-controller="Home" asp-action="Index" class="back-link">← Volver al inicio</a>
    <button type="button" id="historiaReopen" class="historia-reopen">⚑ Ver la historia de la sala</button>
    <div class="challenge-panel">
        <span class="badge">Desafío 5 · Scaloni</span>
        <h1>EL CAMINO</h1>
        <p>
           Scaloni te va a mostrar el camino para ganar la copa del mundo. Vos lo tenes que memorizar y despues repetirlo en el mismo orden. Cuidado que si perdes cerca del final van a pensar que te apuraron para que pierdas y acordate que NO PODES IR PARA ATRAS
        </p>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(correcto ? "alert-success" : "alert-danger")">@mensaje</div>
        }

        <div class="maze-box">
            <p>Memorizar y reproducir el camino: hacé clic en las casillas desde la columna izquierda hasta la derecha siguiendo el recorrido mostrado.</p>

            <div class="maze-controls">
                <button id="newPathBtn" class="btn btn-sm btn-outline-light">Generar camino</button>
                <button id="revealPathBtn" class="btn btn-sm btn-outline-light">Mostrar camino</button>
            </div>

            <div id="mazeGrid" class="maze-grid" aria-label="Grilla del laberinto"></div>
            <div id="mazeResult" style="margin-top:10px;font-weight:700"></div>
        </div>

        <script src="/js/scaloni.js"></script>
    </div>
</div>
