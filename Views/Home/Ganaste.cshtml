@{
    ViewData["Title"] = "¡Ganaste!";
    var codigoSesion = TempData["CodigoSesion"] as string;
}

@Html.Partial("_Timer", (object)ViewBag.TiempoRestanteSegundos)

<div class="challenge-page">
    <div class="challenge-panel text-center">
        <span class="badge">Final</span>
        <h1>¡Pezzela escapó del container!</h1>
        <p>
            Superaste las 7 salas, resolviste cada desafío y lograste salir de Cantilo con la misión cumplida.
        </p>

        <div class="alert alert-success">
            Felicitaciones: ganaste la sala de escape.
        </div>

        @if (!string.IsNullOrWhiteSpace(codigoSesion))
        {
            <div class="alert alert-info">
                <strong>Tu código de sesión completada:</strong> <code>@codigoSesion</code>
                <br />
                <small>Guardalo como constancia de tu victoria.</small>
            </div>
        }
    </div>
</div>
