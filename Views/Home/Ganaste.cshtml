@{
    ViewData["Title"] = "¡Ganaste!";
    var codigoSesion = TempData["CodigoSesion"] as string;
    var participante = ViewBag.Participante as string ?? "Jugador";
}

@Html.Partial("_Timer", (object)ViewBag.TiempoRestanteSegundos)

<div class="challenge-page">
    <div class="challenge-panel text-center">
        <span class="badge">Final</span>
        <h1>¡Pezzela escapó del container!</h1>
        <p class="final-nombre">
            <strong>@participante</strong>, pudiste sacar a Pezzella de la cárcel de Cantilo.
        </p>
        <p>
            Superaste las 7 salas, resolviste cada desafío y lograste salir de Cantilo con la misión cumplida. Pezzella está libre gracias a tu esfuerzo y dedicación. ¡Felicidades por tu victoria!
            Dentro de poco seguramente tendrás que ayudar al perro de Martinez Quarta que va estar en la misma situación...
        </p>

        <div class="alert alert-success">
            Felicitaciones: ganaste la sala de escape.
        </div>

        <div class="victory-image">
            <img src="/img/Recindio.jfif" alt="Recindio celebrando" class="img-fluid" style="max-width: 400px; margin: 20px auto; border-radius: 10px;">
        </div>

        @if (!string.IsNullOrWhiteSpace(codigoSesion))
        {
            <div class="alert alert-info">
                <strong>Tu código de sesión completada:</strong> <code>@codigoSesion</code>
                <br />
                <small>Guardalo como constancia de tu victoria.</small>
            </div>
        }
    </div>
</div>
