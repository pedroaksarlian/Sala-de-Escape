@{
    ViewData["Title"] = "Donofrio / Gallardo";
    var mensaje = ViewBag.Mensaje as string;
    var correcto = ViewBag.Correcto is bool value && value;
}

<div class="challenge-page">
    <a asp-controller="Home" asp-action="Index" class="back-link">← Volver al inicio</a>
    <div class="challenge-panel">
        <span class="badge">Desafío 6 · Donofrio + Gallardo</span>
        <h1>Fútbol 11</h1>
        <p>
            El equipo tiene que armarse bien. Pensá en equilibrio, juego por el centro y una presión que no se rompa. ¿Qué formación encaja mejor?
        </p>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(correcto ? "alert-success" : "alert-danger")">@mensaje</div>
        }

        <form asp-controller="Home" asp-action="Donofrio" method="post" class="challenge-form">
            <label for="respuesta">Formación ideal</label>
            <input id="respuesta" name="respuesta" type="text" class="form-control" placeholder="Ej: 4-3-3" />
            <button type="submit" class="btn btn-danger">Resolver</button>
        </form>
    </div>
</div>
