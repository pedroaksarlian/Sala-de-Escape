@{
    ViewData["Title"] = "Tapia";
    ViewBag.HistoriaTitulo = "El Chiqui Tapia";
    ViewBag.HistoriaEfecto = "fade";
    ViewBag.HistoriaImagenes = new[] { "/img/Chiqui.jpg" };
    var mensaje = ViewBag.Mensaje as string;
    var correcto = ViewBag.Correcto is bool value && value;
}

@Html.Partial("_Timer", (object)ViewBag.TiempoRestanteSegundos)

<div class="challenge-page">
    <a asp-controller="Home" asp-action="Index" class="back-link">← Volver al inicio</a>
    <button type="button" id="historiaReopen" class="historia-reopen">⚑ Ver la historia de la sala</button>
    <div class="challenge-panel">
        <span class="badge">Desafío 4 · Tapia</span>
        <h1>LA MAFIA DEL CHIQUI</h1>
        <p>
           Tenes que ordenar los colores de la paleta en el orden correcto para que el chiqui lo verifique. Es como dividir una liga en dos zonas de 15, cada equipo tiene que estar en su zona para que el producto llegue a su maxima expresion.
        </p>

        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="alert @(correcto ? "alert-success" : "alert-danger")">@mensaje</div>
        }

        <div class="challenge-game" id="chiqui-tapia-game">
            <p>Elegí un nivel y colocá los colores de la paleta en el orden que creas correcto para que el chiqui lo verifique.</p>

            <div class="level-select">
                <label>Nivel:</label>
                <button class="level-btn btn btn-sm btn-outline-light" data-level="3">Fácil (3)</button>
                <button class="level-btn btn btn-sm btn-outline-light" data-level="4">Medio (4)</button>
                <button class="level-btn btn btn-sm btn-outline-light" data-level="5">Difícil (5)</button>
            </div>

            <div class="game-area">
                <div class="palette" id="palette" aria-label="Paleta de colores"></div>
                <div class="slots" id="slots" aria-label="Slots para colocar colores"></div>
            </div>

            <div class="controls">
                <button id="verifyBtn" class="btn btn-primary">Verificar</button>
                <button id="resetBtn" class="btn btn-secondary">Reiniciar</button>
            </div>

            <div id="result" class="mt-3" aria-live="polite"></div>
        </div>

        <script src="/js/chiqui-tapia.js"></script>
    </div>
</div>
